// use prisma-8

model User {
  id       ObjectId @id @map("_id")
  email    String   @unique
  username String?
  name     String?
  posts    Post[]
  @@map("users")
}

model Post {
  id       ObjectId @id @map("_id")
  title    String
  content  String?
  author   User     @relation(fields: [authorId], references: [id])
  authorId ObjectId
  @@map("posts")
}

model Producto {
    id         ObjectId @id @map("_id")
    nombre     String
    precio     Double
    disponible Bool

    @@map("productos")
  }

  model Servicio {
    id          ObjectId @id @map("_id")
    nombre      String
    descripcion String?
    precio      Double
    activo      Bool

    @@map("servicios")
  }